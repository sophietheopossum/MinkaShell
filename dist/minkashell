#!/bin/sh
# MinkaShell launcher: runs the session shell through minka-keep, which does
# the work. The keeper runs `minka minkashell` ($MINKA_BIN, else the
# installed /usr/bin/minka, else a build in the checkout), appends its output
# to ~/.local/state/minka/minkashell.log, and starts it again when it dies:
# after 1 s, then 2, 4, 8 and 16, then every 30 s, until a clean exit or the
# compositor is gone. There is no other shell to fall back to.
#
# The session config execs this with the shell's directory as its argument.
# It is not needed now: the keeper finds a checkout's builds from its own
# path.
#
# The keeper beside this script comes first: in a MinkaDE checkout,
# packaging/minka-keep. The session runs a checkout's launcher with whatever
# minkade package is installed, and packages up to 0.93.0 have no
# /usr/lib/minka/minka-keep. An installed launcher has no keeper beside it,
# and uses the one its own package installed. $MINKA_KEEP names another, as
# the packaging tests do.
#
# This must exec the keeper: it takes its parent for the compositor, and
# stops restarting the shell once it has another. To stop the shell for good,
# signal the keeper (this script's PID), not the binary. With no keeper this
# logs why and exits 127.
set -eu

HERE=$(dirname "$0")
for KEEP in "${MINKA_KEEP:-}" "$HERE/../../packaging/minka-keep" /usr/lib/minka/minka-keep; do
    if [ -n "$KEEP" ] && [ -x "$KEEP" ]; then
        exec "$KEEP" minkashell
    fi
done

LOG_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/minka"
mkdir -p "$LOG_DIR" 2> /dev/null || true
printf '\n=== minkashell no minka-keep (MINKA_KEEP, %s or %s), not starting: %s ===\n' \
    "$HERE/../../packaging/minka-keep" /usr/lib/minka/minka-keep "$(date -Is)" \
    2> /dev/null >> "$LOG_DIR/minkashell.log" || true
exit 127
