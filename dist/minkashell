#!/bin/sh
# MinkaShell launcher: runs the session shell with its output captured.
#
# The compositor config starts this with the shell's directory as its
# argument, so the same script serves a repo checkout and an installed tree.
# In a checkout the AntiWebUI binary is $CONFIG/target/release/minkashell;
# an installed tree ships it as $CONFIG/minkashell.
#
# The Quickshell shell (shell.qml) stays in the tree as the fallback, and is
# what runs when there is no binary: a session with the old shell beats a
# session with none. MINKA_SHELL_FRONTEND=quickshell asks for it outright,
# which is the way back if the AntiWebUI shell misbehaves: set it in
# shojiwm-env.fish and log in again.
#
# Output is appended to ~/.local/state/minka/minkashell.log, so what a shell
# printed before it died is still there after the next login. (The old
# `> /tmp/minkashell.log` redirect emptied the log at every session start.)
set -eu

CONFIG="${1:-/usr/share/minka/MinkaShell}"

FRONTEND=antiwebui
if [ "${MINKA_SHELL_FRONTEND:-}" = quickshell ]; then
    FRONTEND=quickshell
elif [ -x "$CONFIG/target/release/minkashell" ]; then
    BIN="$CONFIG/target/release/minkashell"
elif [ -x "$CONFIG/minkashell" ]; then
    BIN="$CONFIG/minkashell"
else
    FRONTEND='quickshell, no AntiWebUI binary'
fi

LOG_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/minka"
LOG="$LOG_DIR/minkashell.log"
mkdir -p "$LOG_DIR"

# Roll at 2MB keeping one generation, as MinkaMon's launcher does.
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 2097152 ]; then
    mv -f "$LOG" "$LOG.1"
fi

printf '\n=== MinkaShell starting (%s): %s ===\n' "$FRONTEND" "$(date -Is)" >> "$LOG"

case "$FRONTEND" in
    antiwebui) exec "$BIN" >> "$LOG" 2>&1 ;;
    # --log-times so the shell's lines can be matched against kernel events.
    *) exec qs --log-times -p "$CONFIG" >> "$LOG" 2>&1 ;;
esac
